{
  "name": "shop-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "api:lint": "redocly lint ../api/openapi.yaml",
    "api:docs": "redocly build-docs ../api/openapi.yaml -o ../docs/api-reference.html"
  },
  "dependencies": {
    "antd": "^6.6.7",
    "axios": "^1.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
