# 复制为 .env 并填入真实值（.env 不入 git）
DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/doro_mall?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=<RDS_USER>
DB_PASSWORD=请替换为RDS密码
# 至少 32 字节的随机字符串，可用: openssl rand -base64 32
JWT_SECRET=请替换为至少32字节的随机密钥
# Redis 仅容器内网访问，密码通过环境变量注入
REDIS_PASSWORD=请替换为Redis密码
